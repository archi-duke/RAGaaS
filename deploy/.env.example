# RAGaaS deploy — shared-infra 엔드포인트 (GoJIRA/docs/ports.md 44370-44399 대역)
# 이 파일을 deploy/.env 로 복사해 값을 채운다. deploy/.env 는 커밋하지 않는다 (.gitignore).
MILVUS_HOST=<shared-infra 호스트>
MILVUS_PORT=44380
FUSEKI_URL=http://<shared-infra 호스트>:44390
NEO4J_URI=bolt://<shared-infra 호스트>:44396
NEO4J_USER=neo4j
NEO4J_PASSWORD=<비밀값>
MONGO_URI=mongodb://<사용자>:<비밀값>@<shared-infra 호스트>:44370/?authSource=admin
MONGO_DB=<DB 이름>
REDIS_URL=redis://<shared-infra 호스트>:44375/0
# 프로바이더 API 키 복호화 키 — 기존 데이터를 암호화한 값을 그대로 써야 한다 (바꾸면 저장된 키 전부 무효)
ENCRYPTION_KEY=<기존 값>
# 파이프라인 구성 이력 저장소 — 공용 Gitea (shared-infra, HTTP 44372). RAGaaS 전용 계정의 토큰 (ragaas 조직 쓰기 권한)
GITEA_SERVER=<shared-infra 호스트>:44372
GITEA_TOKEN=<비밀값>
GITEA_ORG=ragaas
GITEA_PIPELINE_REPO=ragaas-pipelines
